# Secrets for the server functions. `npm run setup` sets these for you; to set
# them by hand: copy to .env, fill in, then
# `npx supabase secrets set --env-file supabase/functions/.env`.

# AI: one OpenRouter key serves every model StoryMode uses. To use your own
# OpenAI, Anthropic or Google key, add it in OpenRouter (Settings →
# Integrations); then pick providers per tier in Admin → AI models.
OPENROUTER_API_KEY=

# Optional: your site's address, shown to OpenRouter as the app's referrer.
SITE_URL=
